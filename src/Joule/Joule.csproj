<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Joule</RootNamespace>
    <AssemblyName>Joule</AssemblyName>
    <ApplicationIcon>Assets\Joule.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Joule</Product>
    <AssemblyTitle>Joule</AssemblyTitle>
    <Description>Joule â€“ see where your laptop's battery goes</Description>
    <Version>1.3.2</Version>
    <NoWarn>$(NoWarn);WPF0001;CA1416;WFO0003</NoWarn>
    <StartupObject>Joule.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only here for the tray icon; keep its global usings out of the WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Joule.ico" />
    <Resource Include="Assets\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Joule.Core\Joule.Core.csproj" />
  </ItemGroup>

</Project>
